<%- include('partials/header') %>

<main class="form-container">
    <h1><%= title %></h1>

    <% if (locals.errors) { %>
        <ul class="validation-errors">
            <% errors.forEach(error => { %>
                <li>❌ <%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/edit-project/<%= project.project_id %>" method="POST" class="crud-form">
        <div class="form-group">
            <label for="title">Project Title:</label>
            <input type="text" id="title" name="title" value="<%= project.title %>" required>
        </div>

        <div class="form-group">
            <label for="organizationId">Assigned Organization:</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">-- Select an Organization --</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>" 
                        <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
                        <%= org.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label for="date">Project Date:</label>
            <input type="date" id="date" name="date" value="<%= project.formattedDate %>" required>
        </div>

        <div class="form-group">
            <label for="location">Location:</label>
            <input type="text" id="location" name="location" value="<%= project.location %>" required>
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="5" required><%= project.description %></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Save Changes</button>
            <a href="/project/<%= project.project_id %>" class="btn-cancel">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>
<%- include('partials/header') %>

<main class="form-container">
    <h1><%= title %></h1>

    <% if (locals.errors) { %>
        <ul class="validation-errors">
            <% errors.forEach(error => { %>
                <li>❌ <%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/new-organization" method="POST" class="crud-form">
        <div class="form-group">
            <label for="name">Organization Name:</label>
            <input
                type="text"
                id="name"
                name="name"
                required
                maxlength="150"
                placeholder="e.g., Red Cross"
            />
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea
                id="description"
                name="description"
                required
                maxlength="500"
                rows="5"
                placeholder="Provide a brief summary of the organization's mission..."
            ></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email:</label>
            <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                required
                placeholder="contact@organization.org"
            />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Create Organization</button>
            <a href="/organizations" class="btn-cancel">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>
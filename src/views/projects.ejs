<%- include('partials/header') %>

<main class="projects-list-container">
    <h1><%= title %></h1>
    
    <% if (projects && projects.length > 0) { %>
        <div class="projects-grid">
            <% projects.forEach(project => { %>
                <article class="project-card">
                    <h2>
                        <a href="/project/<%= project.project_id %>" class="project-title-link">
                            <%= project.title %>
                        </a>
                    </h2>
                    
                    <p class="project-org">
                        <strong>Organization:</strong> 
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>
                </article>
            <% }) %>
        </div>
    <% } else { %>
        <p>No upcoming service projects found at this time.</p>
    <% } %>

    <p><a href="/new-project">Add a New Service Project</a></p>
    
</main>

<%- include('partials/footer') %>
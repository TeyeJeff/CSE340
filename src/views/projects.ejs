<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <% if (projects && projects.length > 0) { %>
        <ul class="projects-list">
            <% projects.forEach(project => { %>
                <li class="project-item">
                    <div class="project-header">
                        <strong>
                            <a href="/project/<%= project.project_id %>" class="project-title-link">
                                <%= project.title %>
                            </a>
                        </strong>
                    </div>
                    <div class="project-details">
                        <p class="project-org">
                            <strong>Organization:</strong> 
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>
                    </div>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No upcoming service projects found at this time.</p>
    <% } %>

    <p><a href="/new-project" class="btn-add">➕ Add a New Service Project</a></p>
</main>

<%- include('partials/footer') %>
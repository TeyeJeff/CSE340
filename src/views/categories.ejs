<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Browse our service projects by sector:</p>
    
    <ul class="categories-list">
        <% categories.forEach(category => { %>
            <li class="category-item">
                📁 <strong>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </strong> 
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
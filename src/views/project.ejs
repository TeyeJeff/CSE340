<%- include('partials/header') %>

<main class="project-detail-container">
    <h1><%= project.title %></h1>
    
    <div class="project-metadata">
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p>
            <strong>Partner Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <% if (locals.categories && categories.length > 0) { %>
            <p class="project-tags">
                <strong>Categories:</strong>
                <% categories.forEach(cat => { %>
                    <a href="/category/<%= cat.category_id %>" class="category-tag" style="display: inline-block; margin-right: 5px; padding: 2px 8px; background-color: #e0e0e0; border-radius: 4px; text-decoration: none; color: #333; font-size: 0.9em;">
                        <%= cat.name %>
                    </a>
                <% }) %>
            </p>
        <% } %>
    </div>

    <hr>

    <section class="project-description">
        <h2>About this Project</h2>
        <p><%= project.description %></p>
    </section>

    <p class="back-link">
        <a href="/projects">&larr; Back to Upcoming Projects</a>
    </p>

    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
</main>

<%- include('partials/footer') %>
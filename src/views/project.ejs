<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>
    
    <div class="project-metadata">
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p>
            <strong>Partner Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <% if (locals.categories && categories.length > 0) { %>
            <p class="project-tags">
                <strong>Categories:</strong>
                <% categories.forEach(cat => { %>
                    <a href="/category/<%= cat.category_id %>" class="category-tag">
                        <%= cat.name %>
                    </a>
                <% }) %>
            </p>
        <% } %>
    </div>

    <hr class="section-divider">

    <section class="project-description-section">
        <h2>About this Project</h2>
        <p><%= project.description %></p>
    </section>

    <div class="page-actions-footer">
        <p class="back-link">
            <a href="/projects">&larr; Back to Upcoming Projects</a>
        </p>
        <div class="admin-actions">
            <a href="/assign-categories/<%= project.project_id %>" class="btn-edit-link">🏷️ Edit Categories</a>
            <a href="/edit-project/<%= project.project_id %>" class="btn-edit">✏️ Edit Project Details</a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
    <%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
       <p>Here are a few of our partner organizations:</p>
        <ul>

            <% organizations.forEach(organization => { %>
                <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a><strong></strong>: <%= organization.contact_email %>
                <p class="org-description"><%= organization.description %></p>
                </li>
            <% }); %>
            
        </ul>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/new-organization" class="btn">Add New Organization</a>
        <% } %>
    </main>
    <%- include('partials/footer') %>
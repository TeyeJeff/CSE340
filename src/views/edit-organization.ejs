<%- include('partials/header') %>

<main class="form-container">
    <h1><%= title %></h1>

    <% if (locals.errors) { %>
        <ul class="validation-errors">
            <% errors.forEach(error => { %>
                <li>❌ <%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" class="crud-form">
        <div class="form-group">
            <label for="name">Organization Name:</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= organizationDetails.name %>"
                required
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea
                id="description"
                name="description"
                required
                maxlength="500"
                rows="5"
            ><%= organizationDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email:</label>
            <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                value="<%= organizationDetails.contact_email %>"
                required
            />
        </div>
        
        <div class="form-group">
            <label for="logoFilename">Logo Filename:</label>
            <input
                type="text"
                id="logoFilename"
                name="logoFilename"
                maxlength="255"
                required
                value="<%= organizationDetails.logo_filename %>"
            />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Update Organization</button>
            <a href="/organization/<%= organizationDetails.organization_id %>" class="btn-cancel">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>
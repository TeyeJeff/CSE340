<%- include('partials/header') %>

<main class="form-container">
    <h1><%= title %></h1>

    <% if (locals.errors) { %>
        <ul class="validation-errors">
            <% errors.forEach(error => { %>
                <li>❌ <%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/new-project" method="POST" class="crud-form">
        <div class="form-group">
            <label for="title">Project Title:</label>
            <input
                type="text"
                id="title"
                name="title"
                maxlength="150"
                required
                placeholder="e.g., Community Park Cleanup"
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Assigned Partner Organization:</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">-- Select an organization --</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>"><%= org.name %></option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label for="date">Project Date:</label>
            <input
                type="date"
                id="date"
                name="date"
                required
            />
        </div>

        <div class="form-group">
            <label for="location">Location:</label>
            <input
                type="text"
                id="location"
                name="location"
                maxlength="255"
                required
                placeholder="e.g., 123 Main Street, Accra"
            />
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea
                id="description"
                name="description"
                maxlength="500"
                rows="5"
                required
                placeholder="Describe the scope of work and volunteer duties..."
            ></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Create Project</button>
            <a href="/projects" class="btn-cancel">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>
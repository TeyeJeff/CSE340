<%- include('partials/header') %>

<main class="form-container">
    <h1><%= projectDetails.title %></h1>
    <h2>Assign Categories</h2>

    <form action="/assign-categories/<%= projectId %>" method="POST" class="crud-form">
        <div class="checkbox-group-container">
            <% categories.forEach(category => { %>
                <div class="checkbox-item-row">
                    <input
                        type="checkbox"
                        id="category-<%= category.category_id %>"
                        name="categoryIds"
                        value="<%= category.category_id %>"
                        <%= assignedCategories.some(ac => ac.category_id === category.category_id) ? 'checked' : '' %>
                    />
                    <label for="category-<%= category.category_id %>"><%= category.name %></label>
                </div>
            <% }); %>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Update Categories</button>
            <a href="/project/<%= projectId %>" class="btn-cancel">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>